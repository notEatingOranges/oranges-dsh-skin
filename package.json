{
  "name": "oranges-dsh-skin",
  "version": "1.0.0",
  "description": "Wallpaper skin for the DeepSeek Harness web client: drop an image in the sidebar dialog to repaint the interface, with adjustable wallpaper opacity and surface transparency.",
  "type": "module",
  "license": "MIT",
  "author": "smallleap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notEatingOranges/oranges-dsh-skin.git"
  },
  "homepage": "https://github.com/notEatingOranges/oranges-dsh-skin#readme",
  "bugs": {
    "url": "https://github.com/notEatingOranges/oranges-dsh-skin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wallpaper",
    "skin",
    "theme",
    "ui"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
